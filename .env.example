PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=electrodb
DB_USER=electrodb_app
DB_PASSWORD=replace_me_locally

PUBLIC_BASE_URL=http://localhost:3000
ENABLE_LAB_CONSOLE=true

# ---------------------------------------------------------------- accounts
# Session cookies. The database stores only a SHA-256 digest of the token in
# the cookie, so no signing secret is needed; rotate sessions by deleting rows
# from user_sessions.
SESSION_COOKIE_NAME=electrodb_sid
SESSION_TTL_HOURS=168
# Set to true when the site is served over HTTPS. Defaults to true in
# production and false otherwise.
SESSION_COOKIE_SECURE=false

# Set to true only when the app sits behind a reverse proxy you control, so
# req.ip (used for rate limiting) reflects the real client.
TRUST_PROXY=false

# `mysql` (default) or `memory`. The preview server and the test suite use
# `memory`; never use it for a real deployment.
PERSONAL_STORE=mysql

# ------------------------------------------------------- first DBA bootstrap
# Used once by `npm run bootstrap:dba` (see docs/setup.md). Keep these out of
# version control in any real deployment, and remove them afterwards.
BOOTSTRAP_DBA_USERNAME=electrodb_dba
BOOTSTRAP_DBA_EMAIL=dba@electrodb.local
BOOTSTRAP_DBA_PASSWORD=replace_with_a_long_unique_password
